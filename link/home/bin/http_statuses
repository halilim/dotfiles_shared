#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/inline'

gemfile do
  source 'https://rubygems.org'
  gem 'rack'
end

require 'rack/utils'

SEPARATORS = {
  'VScode' => ',',
  'RubyMine' => '", "'
}.freeze

SYM_TO_CODE = Rack::Utils::SYMBOL_TO_STATUS_CODE

type = ARGV[0]

unless type
  SYM_TO_CODE.each do |sym, code|
    puts "\n" if code % 100 == 0
    puts "#{code} #{sym}"
  end
  puts "\nFor snippets: #{File.basename(__FILE__)} [#{SEPARATORS.keys.join('|')}]"
  exit
end

separator = SEPARATORS[type]
raise "Unknown type: #{type}. Must be one of: #{SEPARATORS.keys.join(', ')}" unless separator

puts SYM_TO_CODE.flat_map { |sym, code| [code, ":#{sym}"] }.join(separator)
