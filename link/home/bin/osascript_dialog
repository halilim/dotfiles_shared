#!/usr/bin/env osascript -l JavaScript

ObjC.import("stdlib"); // $.exit

/**
 * @param {string[]} argv
 */
function run(argv) {
  if (argv.length < 1) {
    console.log("Usage: osascript_dialog <message>");
    $.exit(1);
    return;
  }

  const app = Application.currentApplication();
  app.includeStandardAdditions = true;

  const defaultButton = "OK";
  const options = { buttons: [defaultButton], defaultButton };
  app.displayDialog(argv[0], options);
}
