#!/usr/bin/env osascript -l JavaScript

ObjC.import("stdlib"); // $.exit

/**
 * @param {string[]} argv
 */
function run(argv) {
  if (argv.length < 1) {
    console.log("Usage: osascript_notify <message> [title]");
    $.exit(1);
    return;
  }

  const app = Application.currentApplication();
  app.includeStandardAdditions = true;

  let options = {};
  if (argv.length > 1) {
    options.withTitle = argv[1];
  }
  app.displayNotification(argv[0], options);
}
