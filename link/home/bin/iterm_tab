#!/usr/bin/env osascript -l JavaScript

// @ts-ignore
const { quote } = Library("jxa_shell.js");

/**
 * @param {string[]} argv
 */
function run(argv) {
  const iTerm = Application("iTerm");
  iTerm.includeStandardAdditions = true;
  const currentWindow = iTerm.currentWindow();
  const newTab = currentWindow.createTabWithDefaultProfile();
  const newSession = newTab.currentSession();
  if (argv.length > 0) {
    const dir = argv[0];
    if (dir != ".") {
      newSession.write({ text: `cd ${quote(dir)}` });
    }
    const argvRest = argv.slice(1);
    const isComment = /^\s*#/.test(argvRest[0]);
    newSession.write({
      text: isComment ? argvRest.join(" ") : quote(argvRest),
    });
  }
}
